<!DOCTYPE html>
<html{% if app.request.locale in ['fa', 'ar', 'he'] %} dir="rtl" lang="{{ app.request.locale }}"{% endif %}>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        <h1>Twig template loaded! {{ "How could is that?" }}</h1>
        {% block body %}{% endblock %}
        {% block javascripts %}{% endblock %}
    </body>
</html>
